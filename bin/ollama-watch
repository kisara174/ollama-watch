#!/bin/sh
set -eu

DEFAULT_MODEL='qwen3.5:9b'

usage() {
    cat <<'EOF'
Usage: ollama-watch [model]

Run an Ollama model in a temporary tmux workspace with live Apple Silicon
resource monitoring. The default model is qwen3.5:9b.

Options:
  -h, --help  Show this help message
EOF
}

if [ "$#" -gt 1 ]; then
    printf '%s\n' 'Usage: ollama-watch [model]' >&2
    exit 1
fi

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

MODEL=${1:-$DEFAULT_MODEL}
SESSION="ollama-watch-$$"

require_command() {
    command_name=$1
    install_hint=$2
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'Missing dependency: %s\n' "$command_name" >&2
        printf 'Install it with: %s\n' "$install_hint" >&2
        exit 1
    fi
}

shell_quote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

require_command ollama 'brew install ollama'
require_command tmux 'brew install tmux'
require_command macmon 'brew install macmon'

if ! MODEL_LIST=$(ollama list 2>&1); then
    printf '%s\n' 'Unable to read installed Ollama models.' >&2
    printf '%s\n' "$MODEL_LIST" >&2
    exit 1
fi

if ! printf '%s\n' "$MODEL_LIST" | awk 'NR > 1 { print $1 }' | grep -Fx -- "$MODEL" >/dev/null 2>&1; then
    printf 'Model is not installed: %s\n' "$MODEL" >&2
    printf 'Install it explicitly with: ollama pull %s\n' "$MODEL" >&2
    exit 1
fi

SESSION_CREATED=0
CLEANUP_NEEDED=1

cleanup_partial_session() {
    if [ "$SESSION_CREATED" -eq 1 ] && [ "$CLEANUP_NEEDED" -eq 1 ]; then
        tmux kill-session -t "$SESSION" >/dev/null 2>&1 || true
    fi
}
trap cleanup_partial_session EXIT HUP INT TERM

tmux new-session -d -s "$SESSION" -n ollama-watch
SESSION_CREATED=1

LEFT_PANE="$SESSION:0.0"
RIGHT_TOP=$(tmux split-window -h -p 35 -t "$LEFT_PANE" -P -F '#{pane_id}')
RIGHT_BOTTOM=$(tmux split-window -v -p 35 -t "$RIGHT_TOP" -P -F '#{pane_id}')

MODEL_QUOTED=$(shell_quote "$MODEL")
SESSION_QUOTED=$(shell_quote "$SESSION")
OLLAMA_COMMAND="ollama run $MODEL_QUOTED; command_status=\$?; tmux kill-session -t $SESSION_QUOTED >/dev/null 2>&1 || true; exit \$command_status"
STATUS_COMMAND="while :; do clear; date '+%Y-%m-%d %H:%M:%S'; printf '\\nOllama models in memory:\\n'; ollama ps; sleep 2; done"

tmux send-keys -t "$RIGHT_TOP" 'exec macmon' C-m
tmux send-keys -t "$RIGHT_BOTTOM" "$STATUS_COMMAND" C-m
tmux send-keys -t "$LEFT_PANE" "$OLLAMA_COMMAND" C-m
tmux select-pane -t "$LEFT_PANE"

if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$SESSION"
else
    tmux attach-session -t "$SESSION"
fi

CLEANUP_NEEDED=0
